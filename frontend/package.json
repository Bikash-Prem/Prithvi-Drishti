{
  "name": "prithvidrishti-frontend",
  "version": "0.3.0",
  "description": "Prithvi Drishti — environmental intelligence landing page and operations dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\"",
