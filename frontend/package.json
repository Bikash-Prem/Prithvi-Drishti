  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "puppeteer-core": "^25.12.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
